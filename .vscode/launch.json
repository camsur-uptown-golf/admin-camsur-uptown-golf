{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Admin dashboard",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "(http://(?:localhost|127\\.0\\.0\\.1):\\d+)",
        "uriFormat": "http://localhost:4000",
        "action": "openExternally"
      }
    }
  ]
}
